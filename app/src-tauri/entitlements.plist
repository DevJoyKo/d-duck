<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime exceptions for the Developer ID build (D-179, change notarized-release).
     Only what the app uses: Apple Events, to open Terminal on a selected background session (osascript).
     No JIT, unsigned-memory or library-validation exceptions. Applied by app/scripts/release-local.sh only;
     tauri.conf.json carries no signing settings on purpose (one source of truth). -->
<plist version="1.0">
<dict>
  <key>com.apple.security.automation.apple-events</key>
  <true/>
</dict>
</plist>
